    <SolidColorBrush x:Key="PersianDatePickerPressedBackgroundDarkClassic" Color="#FF4A3518"/>
    <SolidColorBrush x:Key="PersianDatePickerDisabledForegroundDarkClassic" Color="#FF777777"/>

