                            <Setter TargetName="PART_Button" Property="Control.Foreground" Value="{DynamicResource PersianDatePickerIconBackgroundDarkClassic}"/>
                            <Setter TargetName="PART_Button" Property="Control.Padding" Value="0,2,2,2"/>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="PART_TextBox" Property="TextBoxBase.IsSelectionActive" Value="True"/>
                                <Condition SourceName="PART_Button" Property="UIElement.IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Button" Property="Control.Foreground" Value="White"/>
                            <Setter TargetName="PART_Button" Property="Control.Background" Value="{DynamicResource PersianDatePickerPointerOverBackgroundDarkClassic}"/>
                            <Setter TargetName="PART_Button" Property="Control.Padding" Value="0,2,2,2"/>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="PART_TextBox" Property="TextBoxBase.IsSelectionActive" Value="True"/>
                                <Condition SourceName="PART_Button" Property="ButtonBase.IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Button" Property="Control.Foreground" Value="White"/>
                            <Setter TargetName="PART_Button" Property="Control.Background" Value="{DynamicResource PersianDatePickerPressedBackgroundDarkClassic}"/>
                            <Setter TargetName="PART_Button" Property="Control.Padding" Value="0,2,2,2"/>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="PART_TextBox" Property="TextBoxBase.IsSelectionActive" Value="False"/>
                                <Condition SourceName="PART_Button" Property="UIElement.IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Button" Property="Control.Background" Value="{DynamicResource PersianDatePickerPointerOverBackgroundDarkClassic}"/>
                            <Setter TargetName="PART_Button" Property="Control.Foreground" Value="{DynamicResource PersianDatePickerIconBackgroundDarkClassic}"/>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="PART_TextBox" Property="TextBoxBase.IsSelectionActive" Value="False"/>
                                <Condition SourceName="PART_Button" Property="ButtonBase.IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Button" Property="Control.Background" Value="{DynamicResource PersianDatePickerPressedBackgroundDarkClassic}"/>
                            <Setter TargetName="PART_Button" Property="Control.Foreground" Value="White"/>
                        </MultiTrigger>

                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter TargetName="Background" Property="Border.Background" Value="{DynamicResource PersianDatePickerBackgroundDarkClassic}"/>
                            <Setter TargetName="Background" Property="Border.BorderBrush" Value="{DynamicResource PersianDatePickerBorderBrushDarkClassic}"/>
                            <Setter TargetName="HeaderContentPresenter" Property="controls:ContentPresenterEx.Foreground" Value="{DynamicResource PersianDatePickerDisabledForegroundDarkClassic}"/>
                            <Setter TargetName="PART_TextBox" Property="Control.Foreground" Value="{DynamicResource PersianDatePickerDisabledForegroundDarkClassic}"/>
                            <Setter TargetName="PART_Button" Property="Control.Foreground" Value="{DynamicResource PersianDatePickerDisabledForegroundDarkClassic}"/>
                            <Setter TargetName="PART_Button" Property="Control.Background" Value="{DynamicResource PersianDatePickerBorderBrushDarkClassic}"/>
                        </Trigger>

                        <Trigger SourceName="PART_TextBox" Property="TextBoxBase.IsSelectionActive" Value="True">
                            <Setter TargetName="PART_TextBox" Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


