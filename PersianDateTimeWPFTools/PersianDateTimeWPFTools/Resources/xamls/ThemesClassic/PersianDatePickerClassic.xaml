                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="PART_TextBox" Property="TextBoxBase.IsSelectionActive" Value="True"/>
                                <Condition SourceName="PART_Button" Property="UIElement.IsMouseOver" Value="False"/>
                                <Condition SourceName="PART_Button" Property="ButtonBase.IsPressed" Value="False"/>
