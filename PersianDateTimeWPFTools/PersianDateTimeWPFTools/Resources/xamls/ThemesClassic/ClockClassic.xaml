                                            Width="42"
                                            Height="42"
                                            Style="{StaticResource ClockRadioButtonLightClassic}"
                                            Content="{DynamicResource PmText}" />
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- Dial -->
                            <Canvas
                                Name="PART_Canvas"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Margin="16,35"
                                VerticalAlignment="Center"
                                Width="220"
                                Height="280">
                               
                                <!-- Bezel ring -->
                                <Grid
                                    Width="220"
                                    Height="220">
                                    <Ellipse
                                        Stroke="{DynamicResource ClockBezelBrushLightClassic}"
                                        StrokeThickness="6"
                                        Fill="{DynamicResource ClockBodyBackgroundLightClassic}" />
                                    <Canvas>
                                        <Line
                                            X1="110"
                                            Y1="10"
                                            X2="110"
                                            Y2="28"
                                            Stroke="{DynamicResource ClockTickMajorLightClassic}"
                                            StrokeThickness="2" />
                                        <Line
                                            X1="200"
                                            Y1="110"
                                            X2="182"
                                            Y2="110"
                                            Stroke="{DynamicResource ClockTickMajorLightClassic}"
                                            StrokeThickness="2" />
                                        <Line
                                            X1="110"
                                            Y1="200"
                                            X2="110"
                                            Y2="182"
                                            Stroke="{DynamicResource ClockTickMajorLightClassic}"
                                            StrokeThickness="2" />
                                        <Line
                                            X1="20"
                                            Y1="110"
                                            X2="38"
                                            Y2="110"
                                            Stroke="{DynamicResource ClockTickMajorLightClassic}"
                                            StrokeThickness="2" />
                                        <Line
                                            X1="110"
                                            Y1="14"
                                            X2="110"
                                            Y2="24"
                                            Stroke="{DynamicResource ClockTickMinorLightClassic}"
                                            StrokeThickness="1" />
                                        <Line
                                            X1="196"
                                            Y1="110"
                                            X2="186"
                                            Y2="110"
                                            Stroke="{DynamicResource ClockTickMinorLightClassic}"
                                            StrokeThickness="1" />
                                        <Line
                                            X1="110"
                                            Y1="196"
                                            X2="110"
                                            Y2="186"
                                            Stroke="{DynamicResource ClockTickMinorLightClassic}"
                                            StrokeThickness="1" />
                                        <Line
                                            X1="24"
                                            Y1="110"
                                            X2="34"
                                            Y2="110"
                                            Stroke="{DynamicResource ClockTickMinorLightClassic}"
                                            StrokeThickness="1" />
                                    </Canvas>
                                </Grid>

                                <!-- Numbers via existing ClockPanel -->
                                <tools:ClockPanel
                                    Visibility="Visible"
                                    Diameter="175"
                                    Opacity="0"
                                    KeepVertical="True"
                                    TextBlock.Foreground="{DynamicResource ClockDigitLightClassic}"
                                    Margin="24,24,0,0"
                                    
                                    OffsetAngle="-90">
                                    <RadioButton
                                        Tag="{Binding Source=12, Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">12</RadioButton>
                                    <RadioButton
                                        Tag="{Binding Source=1,Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">1</RadioButton>
                                    <RadioButton
                                        Tag="{Binding Source=2, Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">2</RadioButton>
                                    <RadioButton
                                        Tag="{Binding Source=3, Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">3</RadioButton>
                                    <RadioButton
                                        Tag="{Binding Source=4, Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">4</RadioButton>
                                    <RadioButton
                                        Tag="{Binding Source=5, Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">5</RadioButton>
                                    <RadioButton
                                        Tag="{Binding Source=6, Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">6</RadioButton>
                                    <RadioButton
                                        Tag="{Binding Source=7, Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">7</RadioButton>
                                    <RadioButton
                                        Tag="{Binding Source=8, Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">8</RadioButton>
                                    <RadioButton
                                        Tag="{Binding Source=9, Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">9</RadioButton>
                                    <RadioButton
                                        Tag="{Binding Source=10,Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">10</RadioButton>
                                    <RadioButton
                                        Tag="{Binding Source=11,Converter={tools:StringToIntConverter}}"
                                        Style="{StaticResource ClockHourRadioButtonLightClassic}">11</RadioButton>
                                    <tools:ClockPanel.Triggers>
                                        <EventTrigger
                                            RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="1"
                                                        Duration="0:0:0.3" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger
                                            RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        BeginTime="0:0:0.7"
                                                        To="0"
                                                        From="3"
                                                        Duration="0:0:0.9" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </tools:ClockPanel.Triggers>
                                </tools:ClockPanel>

                                <tools:ClockPanel
                                    Visibility="Collapsed"
                                    x:Name="PART_PanelNum"
                                    Diameter="176"
                                    Opacity="0"
                                    KeepVertical="True"
                                    Margin="22,22,0,0"
                                    OffsetAngle="-60"
                                    >
                                   



                                </tools:ClockPanel>


                                <!-- Hour hand -->
                                <Border
                                    Name="PART_BorderClock"
                                    Background="{DynamicResource SelectedButtonBackgroundColorLightClassic}"
                                    RenderTransformOrigin="0.5,1"
                                    Height="72"
                                    Width="2"
                                    Canvas.Left="110"
                                    Canvas.Top="38" />

                                <!-- Hub -->
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="{DynamicResource SelectedButtonBackgroundColorLightClassic}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource ClockBezelBrushLightClassic}"
                                    Canvas.Top="104"
                                    Canvas.Left="106" />
                            </Canvas>
                        </Grid>

                        <TextBlock
                            Visibility="Collapsed"
                            Grid.Column="2"
                            Margin="0,20"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{DynamicResource NormalForegroundLightClassic}"
                            Text="{Binding Path=Text, ElementName=PART_TimeStr, Converter={tools:TimeStringConverter StringInputType=HH_MM_ss_String, StringOutputType=Second}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>