    <!-- ====== Radio Buttons (AM/PM + Hour Buttons) Dark Classic ====== -->
    <Style
        x:Key="ClockRadioButtonDarkClassic"
        TargetType="{x:Type RadioButton}">
        <Setter
            Property="Foreground"
            Value="{DynamicResource NormalForegroundDarkClassic}" />
        <Setter
            Property="Background"
            Value="{DynamicResource SelectedButtonBackgroundColorDarkClassic}" />
        <Setter
            Property="Width"
            Value="28" />
        <Setter
            Property="Height"
            Value="28" />
        <Setter
            Property="HorizontalContentAlignment"
            Value="Center" />
        <Setter
            Property="VerticalContentAlignment"
            Value="Center" />
        <Setter
            Property="Focusable"
            Value="False" />
        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type RadioButton}">
                    <Grid>
                        <!-- Classic capsule with subtle bevel -->
                        <Border
                            x:Name="Capsule"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource ClockBezelBrushDarkClassic}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True" />
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger
                            Property="IsChecked"
                            Value="True">
                            <Setter
                                TargetName="Capsule"
                                Property="BorderBrush"
                                Value="{DynamicResource ClockTickMajorDarkClassic}" />
                        </Trigger>
                        <Trigger
                            Property="IsMouseOver"
                            Value="True">
                            <Setter
                                TargetName="Capsule"
                                Property="BorderBrush"
                                Value="{DynamicResource ClockDigitDarkClassic}" />
                        </Trigger>
                        <Trigger
                            Property="IsEnabled"
                            Value="False">
                            <Setter
                                Property="Opacity"
                                Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ClockHourRadioButtonDarkClassic"
        TargetType="{x:Type RadioButton}"
        BasedOn="{StaticResource ClockRadioButtonDarkClassic}">
        <Setter
            Property="Width"
            Value="26" />
        <Setter
            Property="Height"
            Value="26" />
        <Setter
            Property="Foreground"
            Value="White" />

        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type RadioButton}">
                    <Grid>
                        <!-- Round marker for hour selections -->
                        <!--Fill="{TemplateBinding Background}"-->
                        <Ellipse
                            x:Name="Circle"
                            Fill="{DynamicResource ClockDigitLightClassic}"
                            Stroke="{DynamicResource ClockBezelBrushDarkClassic}"
                            StrokeThickness="1" />
                        <ContentPresenter
                            
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger
                            Property="IsChecked"
                            Value="True">
                            <Setter
                                TargetName="Circle"
                                Property="Stroke"
                                Value="{DynamicResource ClockTickMajorDarkClassic}" />
                        </Trigger>
                        <Trigger
                            Property="IsMouseOver"
                            Value="True">
                            <Setter
                                TargetName="Circle"
                                Property="Stroke"
                                Value="{DynamicResource ClockDigitDarkClassic}" />
                        </Trigger>
                        <Trigger
                            Property="IsEnabled"
                            Value="False">
                            <Setter
                                Property="Opacity"
                                Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

