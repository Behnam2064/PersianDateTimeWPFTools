    <SolidColorBrush
        x:Key="PersianDateTimePickerTextBoxBorderBrushDarkClassic"
        Color="#FF555555" />

    <SolidColorBrush
        x:Key="NormalForegroundPersianDateTimePickerDarkClassic"
        Color="#FFD0D0D0" />

    <SolidColorBrush
        x:Key="PersianDateTimePickerBackgroundDarkClassic"
        Color="#FF202020" />

    <SolidColorBrush
        x:Key="PersianDateTimePickerBorderBrushDarkClassic"
        Color="#FF555555" />

    <SolidColorBrush
        x:Key="PersianDateTimePickerAccentDarkClassic"
        Color="#FFB97A1E" />

    <SolidColorBrush
        x:Key="PersianDateTimePickerPointerOverBackgroundDarkClassic"
        Color="#FF302A22" />

    <SolidColorBrush
        x:Key="PersianDateTimePickerPressedBackgroundDarkClassic"
        Color="#FF4A3518" />

    <SolidColorBrush
        x:Key="PersianDateTimePickerSelectedBackgroundDarkClassic"
        Color="#FF3A3A3A" />

    <SolidColorBrush
