    <SolidColorBrush
        x:Key="PersianDateTimePickerAccentLightClassic"
        Color="#FFB97A1E" />

    <SolidColorBrush
        x:Key="PersianDateTimePickerPointerOverBackgroundLightClassic"
        Color="#FFE9D8BC" />

    <SolidColorBrush
        x:Key="PersianDateTimePickerPressedBackgroundLightClassic"
        Color="#FFD8B77F" />

    <SolidColorBrush
        x:Key="PersianDateTimePickerSelectedBackgroundLightClassic"
        Color="#FFFFFFFF" />

