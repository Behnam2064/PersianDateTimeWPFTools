    <!-- ============================================================
         DARK DATETIME PICKER
         ============================================================ -->

    <Style
        x:Key="PersianDateTimePickerDarkClassic"
        TargetType="{x:Type controls:PersianDateTimePicker}">

        <Setter
            Property="Control.Foreground"
            Value="{DynamicResource NormalForegroundPersianDateTimePickerDarkClassic}" />

        <Setter
            Property="controls:PersianDateTimePicker.IsTodayHighlighted"
            Value="True" />

        <Setter
            Property="controls:PersianDateTimePicker.Height"
            Value="30" />

        <Setter
            Property="controls:PersianDateTimePicker.SelectedDateFormat"
            Value="Short" />

        <!--
            IMPORTANT:
            Date + Clock popup uses the Classic combined theme.
            Therefore Calendar and Today button are also Classic.
        -->
        <Setter
            Property="controls:PersianDateTimePicker.PersianCalendarWithClockStyle"
            Value="{DynamicResource PersianCalendarWithClockDarkClassic}" />

        <Setter
            Property="Control.Background"
            Value="{DynamicResource PersianDateTimePickerBackgroundDarkClassic}" />

        <Setter
            Property="Control.BorderBrush"
            Value="{DynamicResource PersianDateTimePickerBorderBrushDarkClassic}" />

        <Setter
            Property="Control.BorderThickness"
            Value="2" />

        <Setter
            Property="Control.HorizontalContentAlignment"
            Value="Stretch" />

        <Setter
            Property="Control.VerticalContentAlignment"
            Value="Center" />

        <Setter
            Property="Control.FontSize"
            Value="{DynamicResource ControlContentThemeFontSize}" />

        <Setter
            Property="Control.Padding"
            Value="1" />

        <Setter
            Property="FrameworkElement.FocusVisualStyle"
            Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}" />

        <Setter
            Property="primitives:FocusVisualHelper.UseSystemFocusVisuals"
            Value="{DynamicResource IsApplicationFocusVisualKindReveal}" />

        <Setter
            Property="primitives:ControlHelper.CornerRadius"
            Value="6" />

        <Setter
            Property="Control.Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type controls:PersianDateTimePicker}">

                    <FrameworkTemplate.Resources>

                        <Style
                            TargetType="{x:Type primitives:DatePickerTextBox}"
                            BasedOn="{StaticResource PersianDateTimePickerTextBoxDarkClassic}" />

                    </FrameworkTemplate.Resources>

                    <Grid
                        ShowGridLines="False"
                        SnapsToDevicePixels="True">

                        <Grid.RowDefinitions>

                            <RowDefinition
                                Height="Auto" />

                            <RowDefinition
                                Height="*" />

                            <RowDefinition
                                Height="Auto" />

                        </Grid.RowDefinitions>

                        <controls:ContentPresenterEx
                            x:Name="HeaderContentPresenter"
                            Visibility="{TemplateBinding primitives:ControlHelper.HeaderVisibility}"
                            Content="{TemplateBinding primitives:ControlHelper.Header}"
                            ContentTemplate="{TemplateBinding primitives:ControlHelper.HeaderTemplate}"
                            Margin="{StaticResource CalendarDatePickerTopHeaderMargin}"
                            TextWrapping="Wrap"
                            SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />

                        <Grid
                            x:Name="PART_Root"
                            Grid.Row="1">

                            <FrameworkElement.Resources>

                                <ControlTemplate
                                    x:Key="DropDownButtonTemplate"
                                    TargetType="{x:Type Button}">

                                    <Grid>

                                        <Rectangle
                                            Fill="{TemplateBinding Control.Background}"
                                            Margin="{TemplateBinding Control.Padding}" />

                                        <TextBlock
                                            x:Name="PART_Icon"
                                            Foreground="{TemplateBinding Control.Foreground}"
                                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                            FontSize="12"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="&#xE787;" />

                                    </Grid>

                                </ControlTemplate>

                            </FrameworkElement.Resources>

                            <Border
                                x:Name="Background"
                                Background="{TemplateBinding Control.Background}"
                                BorderBrush="{TemplateBinding Control.BorderBrush}"
                                BorderThickness="{TemplateBinding Control.BorderThickness}"
                                CornerRadius="{TemplateBinding primitives:ControlHelper.CornerRadius}"
                                MinHeight="30" />

                            <primitives:DatePickerTextBox
                                x:Name="PART_TextBox"
                                BorderThickness="{TemplateBinding Control.BorderThickness}"
                                Padding="7,0,34,0"
                                HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                                Focusable="{TemplateBinding UIElement.Focusable}"
                                primitives:ControlHelper.CornerRadius="{TemplateBinding primitives:ControlHelper.CornerRadius}" />

                            <Button
                                x:Name="PART_Button"
                                Focusable="False"
                                Background="Transparent"
                                Foreground="{TemplateBinding Control.Foreground}"
                                Width="30"
                                Padding="0,1,1,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Template="{StaticResource DropDownButtonTemplate}" />

                            <Popup
                                x:Name="PART_Popup"
                                Margin="0"
                                AllowsTransparency="False"
                                Placement="Bottom"
                                StaysOpen="False" />

                        </Grid>

                        <ContentPresenter
                            x:Name="DescriptionPresenter"
                            Grid.Row="2"
                            Content="{TemplateBinding primitives:ControlHelper.Description}"
                            Visibility="{TemplateBinding primitives:ControlHelper.DescriptionVisibility}"
                            TextElement.Foreground="{DynamicResource PersianDateTimePickerDisabledForegroundDarkClassic}"
                            SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger
                            SourceName="PART_Root"
                            Property="UIElement.IsMouseOver"
                            Value="True">

                            <Setter
                                TargetName="Background"
                                Property="Border.Background"
                                Value="{DynamicResource PersianDateTimePickerPointerOverBackgroundDarkClassic}" />

                            <Setter
                                TargetName="Background"
                                Property="Border.BorderBrush"
                                Value="{DynamicResource PersianDateTimePickerAccentDarkClassic}" />

                        </Trigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition
                                    SourceName="PART_TextBox"
                                    Property="TextBoxBase.IsSelectionActive"
                                    Value="True" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="UIElement.IsMouseOver"
                                    Value="False" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="ButtonBase.IsPressed"
                                    Value="False" />

                            </MultiTrigger.Conditions>

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="{DynamicResource PersianDateTimePickerAccentDarkClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Padding"
                                Value="0,2,2,2" />

                        </MultiTrigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition
                                    SourceName="PART_TextBox"
                                    Property="TextBoxBase.IsSelectionActive"
                                    Value="True" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="UIElement.IsMouseOver"
                                    Value="True" />

                            </MultiTrigger.Conditions>

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="White" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Background"
                                Value="{DynamicResource PersianDateTimePickerPointerOverBackgroundDarkClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Padding"
                                Value="0,2,2,2" />

                        </MultiTrigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition
                                    SourceName="PART_TextBox"
                                    Property="TextBoxBase.IsSelectionActive"
                                    Value="True" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="ButtonBase.IsPressed"
                                    Value="True" />

                            </MultiTrigger.Conditions>

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="White" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Background"
                                Value="{DynamicResource PersianDateTimePickerPressedBackgroundDarkClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Padding"
                                Value="0,2,2,2" />

                        </MultiTrigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition
                                    SourceName="PART_TextBox"
                                    Property="TextBoxBase.IsSelectionActive"
                                    Value="False" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="UIElement.IsMouseOver"
                                    Value="True" />

                            </MultiTrigger.Conditions>

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Background"
                                Value="{DynamicResource PersianDateTimePickerPointerOverBackgroundDarkClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="{DynamicResource PersianDateTimePickerAccentDarkClassic}" />

                        </MultiTrigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition
                                    SourceName="PART_TextBox"
                                    Property="TextBoxBase.IsSelectionActive"
                                    Value="False" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="ButtonBase.IsPressed"
                                    Value="True" />

                            </MultiTrigger.Conditions>

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Background"
                                Value="{DynamicResource PersianDateTimePickerPressedBackgroundDarkClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="White" />

                        </MultiTrigger>

                        <Trigger
                            Property="UIElement.IsEnabled"
                            Value="False">

                            <Setter
                                TargetName="Background"
                                Property="Border.Background"
                                Value="{DynamicResource PersianDateTimePickerBackgroundDarkClassic}" />

                            <Setter
                                TargetName="Background"
                                Property="Border.BorderBrush"
                                Value="{DynamicResource PersianDateTimePickerBorderBrushDarkClassic}" />

                            <Setter
                                TargetName="HeaderContentPresenter"
                                Property="controls:ContentPresenterEx.Foreground"
                                Value="{DynamicResource PersianDateTimePickerDisabledForegroundDarkClassic}" />

                            <Setter
                                TargetName="PART_TextBox"
                                Property="Control.Foreground"
                                Value="{DynamicResource PersianDateTimePickerDisabledForegroundDarkClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="{DynamicResource PersianDateTimePickerDisabledForegroundDarkClassic}" />

                        </Trigger>

                        <Trigger
                            SourceName="PART_TextBox"
                            Property="TextBoxBase.IsSelectionActive"
                            Value="True">

                            <Setter
                                TargetName="PART_TextBox"
                                Property="Foreground"
                                Value="White" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Foreground"
                                Value="White" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


