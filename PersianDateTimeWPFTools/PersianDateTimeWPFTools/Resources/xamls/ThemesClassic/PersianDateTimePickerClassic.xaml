                                VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                                Focusable="{TemplateBinding UIElement.Focusable}"
                                primitives:ControlHelper.CornerRadius="{TemplateBinding primitives:ControlHelper.CornerRadius}" />

                            <Button
                                x:Name="PART_Button"
                                Focusable="False"
                                Background="Transparent"
                                Foreground="{TemplateBinding Control.Foreground}"
                                Width="30"
                                Padding="0,1,1,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Template="{StaticResource DropDownButtonTemplate}" />

                            <Popup
                                x:Name="PART_Popup"
                                Margin="0"
                                AllowsTransparency="False"
                                Placement="Bottom"
                                StaysOpen="False" />

                        </Grid>

                        <ContentPresenter
                            x:Name="DescriptionPresenter"
                            Grid.Row="2"
                            Content="{TemplateBinding primitives:ControlHelper.Description}"
                            Visibility="{TemplateBinding primitives:ControlHelper.DescriptionVisibility}"
                            TextElement.Foreground="{DynamicResource PersianDateTimePickerDisabledForegroundLightClassic}"
                            SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger
                            SourceName="PART_Root"
                            Property="UIElement.IsMouseOver"
                            Value="True">

                            <Setter
                                TargetName="Background"
                                Property="Border.Background"
                                Value="{DynamicResource PersianDateTimePickerPointerOverBackgroundLightClassic}" />

                            <Setter
                                TargetName="Background"
                                Property="Border.BorderBrush"
                                Value="{DynamicResource PersianDateTimePickerAccentLightClassic}" />

                        </Trigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition
                                    SourceName="PART_TextBox"
                                    Property="TextBoxBase.IsSelectionActive"
                                    Value="True" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="UIElement.IsMouseOver"
                                    Value="False" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="ButtonBase.IsPressed"
                                    Value="False" />

                            </MultiTrigger.Conditions>

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="{DynamicResource PersianDateTimePickerAccentLightClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Padding"
                                Value="0,2,2,2" />

                        </MultiTrigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition
                                    SourceName="PART_TextBox"
                                    Property="TextBoxBase.IsSelectionActive"
                                    Value="True" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="UIElement.IsMouseOver"
                                    Value="True" />

                            </MultiTrigger.Conditions>

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="White" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Background"
                                Value="{DynamicResource PersianDateTimePickerPointerOverBackgroundLightClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Padding"
                                Value="0,2,2,2" />

                        </MultiTrigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition
                                    SourceName="PART_TextBox"
                                    Property="TextBoxBase.IsSelectionActive"
                                    Value="True" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="ButtonBase.IsPressed"
                                    Value="True" />

                            </MultiTrigger.Conditions>

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="White" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Background"
                                Value="{DynamicResource PersianDateTimePickerPressedBackgroundLightClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Padding"
                                Value="0,2,2,2" />

                        </MultiTrigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition
                                    SourceName="PART_TextBox"
                                    Property="TextBoxBase.IsSelectionActive"
                                    Value="False" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="UIElement.IsMouseOver"
                                    Value="True" />

                            </MultiTrigger.Conditions>

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Background"
                                Value="{DynamicResource PersianDateTimePickerPointerOverBackgroundLightClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="{DynamicResource PersianDateTimePickerAccentLightClassic}" />

                        </MultiTrigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>

                                <Condition
                                    SourceName="PART_TextBox"
                                    Property="TextBoxBase.IsSelectionActive"
                                    Value="False" />

                                <Condition
                                    SourceName="PART_Button"
                                    Property="ButtonBase.IsPressed"
                                    Value="True" />

                            </MultiTrigger.Conditions>

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Background"
                                Value="{DynamicResource PersianDateTimePickerPressedBackgroundLightClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="White" />

                        </MultiTrigger>

                        <Trigger
                            Property="UIElement.IsEnabled"
                            Value="False">

                            <Setter
                                TargetName="Background"
                                Property="Border.Background"
                                Value="{DynamicResource PersianDateTimePickerBackgroundLightClassic}" />

                            <Setter
                                TargetName="Background"
                                Property="Border.BorderBrush"
                                Value="{DynamicResource PersianDateTimePickerBorderBrushLightClassic}" />

                            <Setter
                                TargetName="HeaderContentPresenter"
                                Property="controls:ContentPresenterEx.Foreground"
                                Value="{DynamicResource PersianDateTimePickerDisabledForegroundLightClassic}" />

                            <Setter
                                TargetName="PART_TextBox"
                                Property="Control.Foreground"
                                Value="{DynamicResource PersianDateTimePickerDisabledForegroundLightClassic}" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Control.Foreground"
                                Value="{DynamicResource PersianDateTimePickerDisabledForegroundLightClassic}" />

                        </Trigger>

                        <Trigger
                            SourceName="PART_TextBox"
                            Property="TextBoxBase.IsSelectionActive"
                            Value="True">

                            <Setter
                                TargetName="PART_TextBox"
                                Property="Foreground"
                                Value="#FF333333" />

                            <Setter
                                TargetName="PART_Button"
                                Property="Foreground"
                                Value="#FF333333" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>